# 复制为 deploy/.env 并填写真实值(.env 已 gitignore)
# ── API 服务(server.py)──
SIGN_SERVER=http://127.0.0.1:9099   # 指向 unidbg 签名服务
API_KEYS=changeme-client-key        # 客户端访问密钥(逗号分隔多个); 所有非 admin 接口强制校验
ADMIN_TOKEN=changeme-admin-token    # /admin、/stats 用; 不设则每次启动随机生成(日志可见)
APIKEYS_PATH=/opt/hongguo/apikeys.json
PYTHONPATH=/opt/hongguo/frida:/opt/hongguo
# ── 风控对抗(仅作用于对红果API/CDN的外部请求, 不影响本机签名服务)──
IMPERSONATE=chrome                  # curl_cffi JA3 伪装目标; 空=禁用退回 requests; 报错可改 chrome120
# HONGGUO_PROXY=socks5://user:pass@proxy_host:1080   # 外部请求代理; 不填=直连(机房IP)
